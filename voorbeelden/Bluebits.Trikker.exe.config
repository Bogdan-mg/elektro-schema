<?xml version="1.0"?>
<!--

***     DirectoryUserSettings: Specifies the directory where the user settings file "Instellingen.xml" will be stored
        If empty (default), the directory" [ApplicationData]\Bluebits\Trikker\" will be used
        ( ApplicationData on Windows 7: "C:\Users\[Username]\AppData\Roaming\" )
        
        The user that runs the application needs write access in the specified directory
       
        Examples:
       
          <value></value> (default)
          <value>E:\TrikkerData</value>
          <value>C:\Program Files (x86)\Bluebits\Trikker\</value>
          
          
***     DirectoryLicenseFile: Specifies the directory where the activation file "Trikker.V1.License.triklic" will be stored
        during the activation process, and will be searched when the application is started
        If empty (default), the directory" [ApplicationData]\Bluebits\Trikker\" will be used
        ( ApplicationData on Windows 7: "C:\Users\[Username]\AppData\Roaming\" )
        
        The user that runs the application only needs write access in the specified directory if the user must be able
        to activate the application
       
        Examples:
       
          <value></value> (default)
          <value>E:\TrikkerData</value>
          <value>C:\Program Files (x86)\Bluebits\Trikker\</value>
          
          
***     Home center export settings

        HcExportColorWallFill     : Fill color of walls (Alpha won't work for this color)
        HcExportColorWallOutline  : Outline color of walls
        HcExportColorItemsFill    : Fill color of items (rectangle, stairs)
        HcExportColorItemsOutline : Outline color of items
 -->
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Bluebits.Trikker.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
    </sectionGroup>
  </configSections>

  <!--
  <system.diagnostics>
    <switches>
      <add name="XmlSerialization.Compilation" value="4" />
    </switches>
  </system.diagnostics>
  <system.xml.serialization>
    <xmlSerializer tempFilesLocation="C:\\TrikkerXmlSerializers"/>
  </system.xml.serialization>
-->
  
  <applicationSettings>
    <Bluebits.Trikker.Properties.Settings>
      <setting name="KeepCursorAlwaysAsArrow" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="DirectoryUserSettings" serializeAs="String">
        <value/>
      </setting>
      <setting name="DirectoryLicenseFile" serializeAs="String">
        <value/>
      </setting>
      <setting name="HcExportColorWallFill" serializeAs="String">
        <value>Black</value>
      </setting>
      <setting name="HcExportColorWallOutline" serializeAs="String">
        <value>92, 92, 92</value>
      </setting>
      <setting name="HcExportColorItemsFill" serializeAs="String">
        <value>0, 0, 0, 0</value>
      </setting>
      <setting name="HcExportColorItemsOutline" serializeAs="String">
        <value>48, 48, 48</value>
      </setting>
      <setting name="ClientSize" serializeAs="String">
        <value>0, 0</value>
      </setting>
      <setting name="CheckPrinterOnline" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="NhcExportColorItemsFill" serializeAs="String">
        <value>0, 0, 0, 0</value>
      </setting>
      <setting name="NhcExportMaxPixelsW" serializeAs="String">
        <value>8191</value>
      </setting>
      <setting name="NhcExportMaxPixelsH" serializeAs="String">
        <value>8191</value>
      </setting>
      <setting name="NhcExportMaxPixelsTotal" serializeAs="String">
        <value>16000000</value>
      </setting>
      <setting name="NhcExportMaxBytes" serializeAs="String">
        <value>800000</value>
      </setting>
      <setting name="NhcExportColorWallFill" serializeAs="String">
        <value>178, 175, 161</value>
      </setting>
      <setting name="NhcExportColorWallOutline" serializeAs="String">
        <value>76, 75, 69</value>
      </setting>
      <setting name="NhcExportColorItemsOutline" serializeAs="String">
        <value>76, 75, 69</value>
      </setting>
      <setting name="NhcExportColorDwg" serializeAs="String">
        <value>215, 210, 194</value>
      </setting>
      <setting name="Nhc2ExportColorItemsFill" serializeAs="String">
        <value>0, 0, 0, 0</value>
      </setting>
      <setting name="Nhc2ExportMaxPixelsW" serializeAs="String">
        <value>8000</value>
      </setting>
      <setting name="Nhc2ExportMaxPixelsH" serializeAs="String">
        <value>8000</value>
      </setting>
      <setting name="Nhc2ExportMaxPixelsTotal" serializeAs="String">
        <value>64000000</value>
      </setting>
      <setting name="Nhc2ExportMaxBytes" serializeAs="String">
        <value>2000000</value>
      </setting>
      <setting name="Nhc2ExportColorWallFill" serializeAs="String">
        <value>229, 229, 229</value>
      </setting>
      <setting name="Nhc2ExportColorWallOutline" serializeAs="String">
        <value>99, 99, 99</value>
      </setting>
      <setting name="Nhc2ExportColorItemsOutline" serializeAs="String">
        <value>99, 99, 99</value>
      </setting>
      <setting name="Nhc2ExportColorDwg" serializeAs="String">
        <value>26, 26, 26</value>
      </setting>
      <setting name="Bluebits_Trikker_online1_PartnerService" serializeAs="String">
        <value>http://online.trikker.be/partnerservice.asmx</value>
      </setting>
    </Bluebits.Trikker.Properties.Settings>
  </applicationSettings>
  <appSettings>
    <add key="PDFRasterizer.NET 3.0 Client Application Key" value="nvfGcNZKrksB2t5Z-8Cc-+++"/>
  </appSettings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2"/></startup>
</configuration>

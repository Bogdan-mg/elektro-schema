{
  "name": "elektro-schema",
  "productName": "Elektro Schema",
  "version": "1.0.0",
  "description": "Ééndraadschema's, situatieschema's en materiaallijsten tekenen, volledig offline",
  "author": "Bogdan",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "kopieer": "node kopieer.js",
    "start": "node kopieer.js && electron .",
    "dev": "node kopieer.js && node dev.js",
    "test": "node --test test/*.test.js",
    "dist": "node kopieer.js && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "pdfjs-dist": "6.4.299"
  },
  "build": {
    "appId": "be.elektro-schema.app",
    "productName": "Elektro Schema",
    "files": [
      "main.js",
      "preload.cjs",
      "app/**",
      "build/icon.png",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "eschema",
        "name": "Elektro Schema-project",
        "description": "Elektro Schema-project",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Elektro Schema",
      "artifactName": "Elektro-Schema-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
